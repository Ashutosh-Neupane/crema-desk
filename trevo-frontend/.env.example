# ============================================================
# Trevo Frontend — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
# ============================================================

# ---- Frappe Backend (REQUIRED) ----
# Browser-accessible URL of the Frappe backend.
# Used by the BFF proxy (app/api/frappe/*) and the realtime socket.io client.
# Default local dev: http://localhost:8000
# NEVER use port 8080 — Frappe does not listen there.
NEXT_PUBLIC_FRAPPE_BASE_URL=http://localhost:8000

# Server-side only URL (used by Server Components + API routes).
# Usually the same as NEXT_PUBLIC_FRAPPE_BASE_URL in local dev.
# In Docker, this may differ (e.g. http://frappe-backend:8000 for container networking).
FRAPPE_BACKEND_URL=http://localhost:8000

# ---- Next.js App URL ----
# Public URL where this Next.js app is served.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Optional: Google Maps API Key ----
# Required for the Map View and Geolocation field.
# Get one at https://console.cloud.google.com/
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---- Optional: Sentry Error Tracking ----
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@o0.ingest.sentry.io/xxxxx
# SENTRY_AUTH_TOKEN=sntrys_xxxxx

# ---- Optional: Feature Flags ----
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_ENABLE_CHAT=false

# ---- Docker / Production ----
# Set to "standalone" to enable Next.js standalone output for Docker.
# Corresponds to output: "standalone" in next.config.ts.
# NEXT_OUTPUT=standalone

# Frappe site to serve (sent as X-Frappe-Site-Name). Needed when the backend URL host
# is not the site name, e.g. localhost:8001 for site vendor1.localhost.
# FRAPPE_SITE_NAME=vendor1.localhost
